.worktrees/
.superpowers/
target/
target-mpv/
dist/
.cache/

# Runtime staging keeps documentation and placeholders in git, not binary payloads.
third_party/mpv/**/bin/*
third_party/mpv/**/lib/*
!third_party/mpv/**/bin/.gitkeep
!third_party/mpv/**/lib/.gitkeep

# Generated test clips for manual verification.
.test-media/

# Docs site dependencies and VitePress build output.
docs-site/node_modules/
docs-site/docs/.vitepress/dist/
docs-site/docs/.vitepress/cache/

# Scratch builds used when verifying a runtime by hand.
target-staged/
target-mpv/
target-mpv-dllatest/
# Fallback log directory, used when the app cannot discover its data dir.
logs/
